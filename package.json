{
  "name": "homebridge-wallpad",
  "displayName": "Wallpad Integration for Korean Apartments",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Local RS485 bridge that exposes Korean apartment wallpad devices to HomeKit (and Matter) via Homebridge, without the cloud.",
  "author": "Richard Cho",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/rchrdcho/homebridge-wallpad#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/rchrdcho/homebridge-wallpad.git"
  },
  "bugs": {
    "url": "https://github.com/rchrdcho/homebridge-wallpad/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "wallpad",
    "rs485",
    "korea",
    "korean"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test": "rimraf ./build-test && tsc -p tsconfig.test.json && node --test build-test/test/unit/"
  },
  "dependencies": {
    "homebridge-lib": "^8.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
